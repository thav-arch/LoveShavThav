# Copy to .env.local (development) or set in your host's environment (production).

# First admin account — used once by `npm run db:seed`
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Your Name
ADMIN_PASSWORD=change-me-to-something-long

# PostgreSQL connection. Leave unset in development to use the built-in
# PGlite database saved in ./.data/db.tar.gz (no install needed).
# DATABASE_URL=postgres://user:password@host:5432/portfolio
# DATABASE_POOL_MAX=10

# Public origin of the site — used for canonical URLs, sitemap and JSON-LD
SITE_URL=https://your-domain.com

# Where uploaded media is stored (default ./storage/uploads)
# UPLOAD_DIR=/var/data/uploads
