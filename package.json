{
    "name":  "thavanesh-portfolio",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "predev":  "node --env-file-if-exists=.env.local scripts/db-file.mjs",
                    "dev":  "next dev",
                    "build":  "next build",
                    "prestart":  "node --env-file-if-exists=.env.local scripts/db-file.mjs",
                    "start":  "next start",
                    "db:generate":  "drizzle-kit generate",
                    "predb:migrate":  "node --env-file-if-exists=.env.local scripts/db-file.mjs",
                    "db:migrate":  "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
                    "predb:seed":  "node --env-file-if-exists=.env.local scripts/db-file.mjs",
                    "db:seed":  "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
                    "db:repair":  "node --env-file-if-exists=.env.local scripts/db-file.mjs",
                    "typecheck":  "tsc --noEmit",
                    "prebuild":  "node --env-file-if-exists=.env.local scripts/db-file.mjs && node --env-file-if-exists=.env.local --import tsx scripts/db-snapshot.ts"
                },
    "dependencies":  {
                         "@electric-sql/pglite":  "^0.5.8",
                         "@react-three/fiber":  "^9.8.1",
                         "drizzle-orm":  "^0.45.3",
                         "gsap":  "^3.15.0",
                         "lenis":  "^1.3.26",
                         "marked":  "^18.0.14",
                         "next":  "^16.3.8",
                         "pg":  "^8.23.1",
                         "react":  "^19.3.0",
                         "react-dom":  "^19.3.0",
                         "server-only":  "^0.0.1",
                         "three":  "^0.186.1",
                         "zod":  "^4.6.5",
                         "zustand":  "^5.0.15"
                     },
    "devDependencies":  {
                            "@types/node":  "^22",
                            "@types/pg":  "^8.23.1",
                            "@types/react":  "^19",
                            "@types/react-dom":  "^19",
                            "@types/three":  "^0.186.0",
                            "drizzle-kit":  "^0.31.11",
                            "tsx":  "^4.23.15",
                            "typescript":  "^5.9"
                        },
    "engines":  {
                    "node":  "\u003e=20.9"
                }
}